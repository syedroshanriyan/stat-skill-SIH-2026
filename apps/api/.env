# ============================================================
# STAT-SKILL AI — Environment Configuration
# ============================================================

# Application Environment
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=INFO

# Unified Single-Port & Proxy Configuration
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000

# Backend API Configuration
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Security & Authentication (JWT)
JWT_SECRET=stat-skill-ai-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default / PostgreSQL supported)
DATABASE_URL=sqlite:///./statskill.db

# AI Configuration (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Object Storage (Local filesystem or cloud storage)
STORAGE_BACKEND=local
STORAGE_DIR=./uploads
GCS_BUCKET_NAME=

# Integration Provider Keys (Optional: Falls back to DEMO_CATALOGUE)
IGOT_API_KEY=
NSSTA_API_KEY=
