# ============================================================
# STAT-SKILL AI — Environment Configuration
# ============================================================

# Application Environment
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API Configuration
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","or your own port"]

# Security & Authentication
JWT_SECRET="your jwt-32 key"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 16 + pgvector)
# For local dev without Postgres, fallback SQLite is supported automatically
DATABASE_URL=postgresql://statskill:statskillpass@localhost:5432/statskilldb

# AI Configuration (Google Gemini)
GEMINI_API_KEY= "your api key"
GEMINI_MODEL= "your model"

# Object Storage (Local fallback or Google Cloud Storage)
STORAGE_BACKEND=local
STORAGE_DIR=./uploads
GCS_BUCKET_NAME=

# Integration Provider Keys (Optional: Falls back to DEMO_CATALOGUE)
IGOT_API_KEY=
NSSTA_API_KEY=
